{
  "name": "sira-os",
  "version": "0.3.0",
  "private": true,
  "description": "SIRA — voice-first autonomous company operating system: real multi-agent backend, execution worker, and neural interface.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning src/cli/dev.ts",
    "server": "node --disable-warning=ExperimentalWarning src/server/index.ts",
    "worker": "node --disable-warning=ExperimentalWarning src/worker/index.ts",
    "desktop-bridge": "node --disable-warning=ExperimentalWarning src/desktop-bridge/index.ts",
    "seed": "node --disable-warning=ExperimentalWarning src/cli/seed.ts",
    "eval": "node --disable-warning=ExperimentalWarning src/cli/eval.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --disable-warning=ExperimentalWarning --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/integration/**/*.test.ts\"",
    "test:ui": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/ui/**/*.test.ts\"",
    "test:sdk": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/live/**/*.test.ts\"",
    "test": "npm run typecheck && npm run test:unit && npm run test:integration"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@anthropic-ai/sdk": "^0.115.0"
  }
}
